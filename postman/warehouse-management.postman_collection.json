{
  "info": {
    "name": "Warehouse Management API - Completa",
    "description": "Coleção para testar a API local. Selecione o ambiente Warehouse - Local e execute Login primeiro para preencher {{token}}. Para testar o cadastro inteligente, cadastre o ingrediente sem estoque, execute a entrada automática pelo cadastro e consulte o estoque por compartimento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "login",
      "value": "admin"
    },
    {
      "key": "senha",
      "value": "admin123"
    },
    {
      "key": "ingredientName",
      "value": "Arroz"
    },
    {
      "key": "ingredientType",
      "value": "DRY"
    },
    {
      "key": "ingredientId",
      "value": "1"
    },
    {
      "key": "compartmentId",
      "value": "1"
    },
    {
      "key": "registrationQuantity",
      "value": "100"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (salva JWT automaticamente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Execute primeiro. O script salva accessToken em {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login respondeu HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const token = body.accessToken;",
                  "pm.test('JWT retornado', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "if (token) pm.environment.set('token', token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Ingredientes",
      "item": [
        {
          "name": "Cadastrar ingrediente (sem estoque inicial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredientes"
              ]
            },
            "description": "Cria o ingrediente (201) ou reutiliza seu ID pelo nome normalizado e tipo (200), sem registrar movimentação. Tipos aceitos: DRY, LIQUID ou REFRIGERATED. O script salva o ID em ingredientId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{ingredientName}}\",\n  \"tipo\": \"{{ingredientType}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ingrediente criado ou reutilizado', () => pm.expect(pm.response.code).to.be.oneOf([201, 200]));",
                  "const body = pm.response.json();",
                  "pm.test('ID do ingrediente retornado sem movimentação', () => {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.quantidade).to.be.null;",
                  "  pm.expect(body.compartimento).to.be.null;",
                  "  pm.expect(body.movimentacao).to.be.null;",
                  "});",
                  "if ([201, 200].includes(pm.response.code) && Number.isInteger(body.id)) {",
                  "  pm.environment.set('ingredientId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar entrada automática pelo cadastro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredientes"
              ]
            },
            "description": "Execute Cadastrar ingrediente (sem estoque inicial) primeiro. Os espaços no nome demonstram o reaproveitamento do cadastro. Sem compartimentoId, a API escolhe o primeiro compartimento elegível por código para toda a quantidade. Cada chamada bem-sucedida registra uma entrada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"  {{ingredientName}}  \",\n  \"tipo\": \"{{ingredientType}}\",\n  \"quantidade\": {{registrationQuantity}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Entrada em ingrediente existente retornou HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Entrada reutilizou o ingrediente e informou o destino', () => {",
                  "  pm.expect(body.id).to.equal(Number(pm.variables.get('ingredientId')));",
                  "  pm.expect(body.quantidade).to.equal(Number(pm.variables.get('registrationQuantity')));",
                  "  pm.expect(body.compartimento.id).to.be.a('number');",
                  "  pm.expect(body.movimentacao.tipo).to.equal('INBOUND');",
                  "  pm.expect(body.movimentacao.responsavel).to.equal(pm.variables.get('login'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar ingrediente (com estoque inicial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredientes"
              ]
            },
            "description": "Cria o ingrediente com entrada inicial (201) ou registra uma entrada no ingrediente existente (200). O exemplo usa um destino explícito. Ajuste compartmentId conforme a disponibilidade. O script salva o ID do ingrediente em ingredientId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Farinha de trigo\",\n  \"tipo\": \"DRY\",\n  \"quantidade\": {{registrationQuantity}},\n  \"compartimentoId\": {{compartmentId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ingrediente criado ou reutilizado com entrada', () => pm.expect(pm.response.code).to.be.oneOf([201, 200]));",
                  "const body = pm.response.json();",
                  "pm.test('Movimentação aponta para o destino solicitado', () => {",
                  "  pm.expect(body.compartimento.id).to.equal(Number(pm.variables.get('compartmentId')));",
                  "  pm.expect(body.movimentacao.tipo).to.equal('INBOUND');",
                  "});",
                  "if ([201, 200].includes(pm.response.code) && Number.isInteger(body.id)) {",
                  "  pm.environment.set('ingredientId', body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar ingredientes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredientes"
              ]
            },
            "description": "Lista os ingredientes cadastrados."
          }
        },
        {
          "name": "Buscar ingrediente por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredientes/{{ingredientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredientes",
                "{{ingredientId}}"
              ]
            },
            "description": "Utiliza o ID salvo pela variável ingredientId."
          }
        },
        {
          "name": "Consultar volume total por tipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingredientes/volume",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingredientes",
                "volume"
              ]
            },
            "description": "Consulta o saldo agregado por tipo de ingrediente."
          }
        }
      ]
    },
    {
      "name": "Estoque",
      "item": [
        {
          "name": "Consultar estoque atual por compartimento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque"
              ]
            },
            "description": "Consulta protegida por JWT, sem parâmetros. Lista todos os compartimentos, inclusive vazios, com saldos por ingrediente, capacidade, ocupação e data da última movimentação."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta retornou HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Consulta retornou os cinco compartimentos e seus saldos', () => {",
                  "  pm.expect(body.compartimentos.map(c => c.codigo)).to.eql(['C1', 'C2', 'C3', 'C4', 'C5']);",
                  "  for (const compartment of body.compartimentos) {",
                  "    pm.expect(compartment.status).to.be.oneOf(['EMPTY', 'OCCUPIED', 'BLOCKED']);",
                  "    pm.expect(compartment.ingredientes).to.be.an('array');",
                  "    pm.expect(compartment.percentualOcupacao).to.be.a('number');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrada de estoque",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/entrada",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "entrada"
              ]
            },
            "description": "Registra entrada para ingrediente existente. O responsável é obtido do JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredienteId\": {{ingredientId}},\n  \"compartimentoId\": {{compartmentId}},\n  \"quantidade\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Entrada processada', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Saída de estoque",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estoque/saida",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estoque",
                "saida"
              ]
            },
            "description": "Registra saída. A quantidade não pode superar o saldo disponível.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingredienteId\": {{ingredientId}},\n  \"compartimentoId\": {{compartmentId}},\n  \"quantidade\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Saída processada', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Compartimentos",
      "item": [
        {
          "name": "Disponíveis para armazenamento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/compartimentos/disponiveis?quantidade=50&tipo=DRY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "compartimentos",
                "disponiveis"
              ],
              "query": [
                {
                  "key": "quantidade",
                  "value": "50",
                  "disabled": false
                },
                {
                  "key": "tipo",
                  "value": "DRY",
                  "disabled": false
                }
              ]
            },
            "description": "Filtra compartimentos com espaço livre suficiente para o tipo e a quantidade informados."
          }
        },
        {
          "name": "Disponíveis para venda/retirada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/compartimentos/disponiveis-para-venda?tipo=DRY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "compartimentos",
                "disponiveis-para-venda"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "DRY",
                  "disabled": false
                }
              ]
            },
            "description": "Retorna compartimentos com saldo positivo do tipo solicitado."
          }
        }
      ]
    },
    {
      "name": "Histórico",
      "item": [
        {
          "name": "Histórico - padrão (data desc)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/historico?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "historico"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "disabled": false
                },
                {
                  "key": "size",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "Consulta paginada. O padrão é data decrescente, com 20 registros por página."
          }
        },
        {
          "name": "Histórico - data crescente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/historico?sortBy=date&order=asc&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "historico"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "date",
                  "disabled": false
                },
                {
                  "key": "order",
                  "value": "asc",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "0",
                  "disabled": false
                },
                {
                  "key": "size",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "Ordena pela data em ordem crescente."
          }
        },
        {
          "name": "Histórico - compartimento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/historico?sortBy=compartment&order=asc&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "historico"
              ],
              "query": [
                {
                  "key": "sortBy",
                  "value": "compartment",
                  "disabled": false
                },
                {
                  "key": "order",
                  "value": "asc",
                  "disabled": false
                },
                {
                  "key": "page",
                  "value": "0",
                  "disabled": false
                },
                {
                  "key": "size",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "Ordena pelo compartimento."
          }
        }
      ]
    }
  ]
}
